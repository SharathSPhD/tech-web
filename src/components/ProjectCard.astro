---
import type { Project } from '../data/research';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const toneClass = `tone-${project.tone} accent-${project.accent ?? 'orange'}`;
---

<div class={`pcard lift ${toneClass}`}>
  {
    (project.kicker || project.meta) && (
      <div class="head">
        {project.kicker && <span class="mono kicker-txt">{project.kicker}</span>}
        {project.meta && <span class="mono meta">{project.meta}</span>}
      </div>
    )
  }
  <h4>{project.title}</h4>
  <p class="blurb">{project.blurb}</p>
  {
    project.metrics && project.metrics.length > 0 && (
      <div class="mono metrics">
        {project.metrics.map((m) => (
          <span class={`m-${m.tone ?? 'good'}`}>
            {m.value}
            {m.note && <span class="note"> {m.note}</span>}
          </span>
        ))}
      </div>
    )
  }
  {
    project.links.length > 0 && (
      <div class="links">
        {project.links.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith('#') ? undefined : '_blank'}
            rel={l.href.startsWith('#') ? undefined : 'noopener'}
          >
            {l.label}
          </a>
        ))}
      </div>
    )
  }
</div>

<style>
  .pcard { border-radius: 18px; padding: 24px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .kicker-txt { font-size: 12px; font-weight: 700; }
  .meta { font-size: 10.5px; }
  h4 { font-size: 19px; margin: 12px 0 0; }
  .blurb { font-size: 13.5px; line-height: 1.55; margin: 8px 0 0; }
  .metrics { display: flex; gap: 16px; margin-top: 14px; font-size: 12px; flex-wrap: wrap; }
  .links { display: flex; gap: 12px; margin-top: 16px; font-size: 12.5px; font-weight: 700; flex-wrap: wrap; }

  /* dark terminal card */
  .tone-dark { background: var(--term-bg); color: var(--term-text); }
  .tone-dark h4 { color: #fff; }
  .tone-dark .blurb { color: var(--term-dim); }
  .tone-dark .meta { color: var(--term-faint); }
  .tone-dark.accent-orange .kicker-txt, .tone-dark.accent-orange .links a { color: var(--term-orange); }
  .tone-dark.accent-green .kicker-txt, .tone-dark.accent-green .links a { color: var(--term-green); }
  .tone-dark .m-good { color: var(--term-green); }
  .tone-dark .m-warn { color: var(--term-orange); }
  .tone-dark .m-dim { color: var(--term-faint); }
  .tone-dark .note { color: var(--term-faint); font-size: 10.5px; }

  /* warm card */
  .tone-warm {
    background: var(--color-neutral-100);
    border: 1px solid var(--color-divider);
    padding: 22px;
  }
  .tone-warm .kicker-txt { font-size: 11px; color: var(--color-accent-700); }
  .tone-warm h4 { font-size: 18px; margin-top: 9px; }
  .tone-warm .blurb { color: var(--color-neutral-700); margin-top: 7px; }
  .tone-warm .links { margin-top: 12px; }
  .tone-warm .m-good { color: var(--color-accent-2-700); }
  .tone-warm .m-dim { color: var(--color-neutral-600); }
  .tone-warm .note { color: var(--color-neutral-600); font-size: 10.5px; }

  /* plain small card */
  .tone-plain {
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 16px;
    padding: 20px;
  }
  .tone-plain h4 { font-size: 16.5px; margin: 0; }
  .tone-plain .blurb { font-size: 13px; line-height: 1.5; color: var(--color-neutral-700); margin: 6px 0 0; }
  .tone-plain .links { margin-top: 10px; }
</style>
