---
import { demos } from '../data/demos';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="demos">
  <div class="wrap section-pad">
    <div class="kicker">{demos.kicker}</div>
    <h2>{demos.heading}</h2>
    <p class="sub">{demos.sub}</p>

    <div class="cards">
      {
        demos.cards.map((card) => (
          <div class="demo-card">
            <div class="chrome">
              <span class="dot" style="background:#c96442" />
              <span class="dot" style="background:#7a8a5e" />
              <span class="dot" style="background:#c0b6a5" />
              <span class="mono url">{card.chrome}</span>
            </div>
            <a class="shot" href={card.cta.href} target="_blank" rel="noopener" aria-label={card.title}>
              <img src={`${base}/${card.screenshot}`} alt={card.alt} loading="lazy" />
            </a>
            <div class="body">
              <h4>{card.title}</h4>
              <p>{card.body}</p>
              <a href={card.cta.href} target="_blank" rel="noopener" class="cta">
                {card.cta.label}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="yt">
      <div class="player">
        <iframe
          src={`https://www.youtube.com/embed/videoseries?list=${demos.youtube.playlistId}`}
          title={demos.youtube.title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
      <div class="yt-body">
        <span class="mono yt-kicker">{demos.youtube.kicker}</span>
        <h4>{demos.youtube.title}</h4>
        <p>{demos.youtube.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    margin: 12px 0 0;
    max-width: 720px;
    letter-spacing: -0.015em;
  }
  .sub {
    font-size: 16px;
    color: var(--color-neutral-700);
    max-width: 600px;
    margin: 14px 0 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 34px;
  }
  .demo-card {
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    background: var(--color-neutral-200);
    border-bottom: 1px solid var(--color-divider);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .url {
    margin-left: 6px;
    font-size: 11px;
    color: var(--color-neutral-700);
    background: var(--color-bg);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .shot {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--term-bg);
    overflow: hidden;
  }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .body { padding: 18px 20px; }
  h4 { font-size: 18px; margin: 0; }
  .body p {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-neutral-700);
    margin: 7px 0 0;
  }
  .cta {
    display: inline-block;
    margin-top: 12px;
    background: var(--color-accent);
    color: #fff;
    padding: 10px 18px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
  }

  .yt {
    margin-top: 22px;
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  .player { aspect-ratio: 16 / 9; background: #000; }
  .player iframe { width: 100%; height: 100%; border: 0; display: block; }
  .yt-body {
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .yt-kicker { font-size: 11px; font-weight: 700; color: var(--color-accent-700); }
  .yt-body h4 { font-size: 21px; margin: 9px 0 0; }
  .yt-body p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-neutral-700);
    margin: 9px 0 0;
  }
</style>
