---
import { practice } from '../data/pillars';

const icons: Record<string, string> = {
  ai: '<circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"></path>',
  deeptech:
    '<path d="M12 2a4 4 0 0 0-4 4v1M12 2a4 4 0 0 1 4 4v1"></path><rect x="6" y="7" width="12" height="9" rx="2"></rect><path d="M9 16v3M15 16v3M12 11v2"></path>',
  fintech: '<path d="M3 3v18h18"></path><path d="M7 15l3-4 3 2 4-6"></path>',
};
---

<section id="practice">
  <div class="wrap section-pad">
    <div class="kicker">{practice.kicker}</div>
    <h2>{practice.heading}</h2>
    <p class="sub">{practice.sub}</p>
    <div class="cards">
      {
        practice.cards.map((card) => (
          <a href={card.link.href} class={`card lift accent-${card.accent}`}>
            <div class="icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[card.icon]}
              />
            </div>
            <div class="mono num">{card.number}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="more">{card.link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    margin: 12px 0 0;
    max-width: 760px;
    letter-spacing: -0.015em;
  }
  .sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-700);
    max-width: 640px;
    margin: 16px 0 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 38px;
  }
  .card {
    text-decoration: none;
    color: inherit;
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 20px;
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }
  .icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .accent-accent .icon { background: var(--color-accent-100); color: var(--color-accent-700); }
  .accent-accent2 .icon { background: var(--color-accent-2-200); color: var(--color-accent-2-700); }
  .accent-accentDeep .icon { background: var(--color-accent-200); color: var(--color-accent-800); }
  .num {
    font-size: 11px;
    letter-spacing: 0.06em;
    margin-top: 18px;
    font-weight: 700;
  }
  .accent-accent .num, .accent-accent .more { color: var(--color-accent-700); }
  .accent-accent2 .num, .accent-accent2 .more { color: var(--color-accent-2-700); }
  .accent-accentDeep .num, .accent-accentDeep .more { color: var(--color-accent-800); }
  h3 { font-size: 23px; margin: 8px 0 0; }
  .card p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-neutral-700);
    margin: 8px 0 0;
  }
  .more {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 700;
  }
</style>
