---
import { services } from '../data/pillars';
---

<section id="services">
  <div class="wrap section-pad">
    <div class="kicker">{services.kicker}</div>
    <h2>{services.heading}</h2>
    <p class="sub">{services.sub}</p>
    <div class="cols">
      {
        services.columns.map((col) => (
          <div class="col">
            <h3 style={`color:${col.colorVar}`}>{col.title}</h3>
            <ul>
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    margin: 12px 0 0;
    max-width: 740px;
    letter-spacing: -0.015em;
  }
  .sub {
    font-size: 16px;
    color: var(--color-neutral-700);
    max-width: 620px;
    margin: 14px 0 0;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-top: 34px;
  }
  .col {
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 20px;
    padding: 26px;
  }
  h3 { font-size: 20px; margin: 0; }
  ul {
    margin: 12px 0 0;
    padding-left: 18px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-neutral-800);
  }
</style>
