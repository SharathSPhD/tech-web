---
import { appEmbeds, mediaHub, reads, videos } from '../data/media';

const firstVideo = videos[0]!;
const firstApp = appEmbeds[0]!;
---

<section id="media">
  <div class="wrap section-pad">
    <div class="kicker reveal">{mediaHub.kicker}</div>
    <h2 class="reveal">{mediaHub.heading}</h2>
    <p class="sub reveal">{mediaHub.sub}</p>

    <div class="tabs mono reveal" role="tablist" aria-label="Media hub">
      <button role="tab" aria-selected="true" aria-controls="panel-watch" data-tab="watch">▶ {mediaHub.tabs.watch}</button>
      <button role="tab" aria-selected="false" aria-controls="panel-run" data-tab="run">⚡ {mediaHub.tabs.run}</button>
      <button role="tab" aria-selected="false" aria-controls="panel-read" data-tab="read">✦ {mediaHub.tabs.read}</button>
    </div>

    <!-- WATCH -->
    <div class="panel" id="panel-watch" role="tabpanel">
      <div class="watch-grid">
        <div class="player-shell">
          <iframe
            id="yt-player"
            src={`https://www.youtube-nocookie.com/embed/${firstVideo.id}`}
            title="TechNektar video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="vlist" role="list">
          {
            videos.map((v, i) => (
              <button
                class={`vitem${i === 0 ? ' active' : ''}`}
                data-video={v.id}
                role="listitem"
              >
                <span class="vplay">▶</span>
                <span class="vtitle">{v.title}</span>
                {v.series && <span class="vtag mono">{v.series}</span>}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- RUN -->
    <div class="panel" id="panel-run" role="tabpanel" hidden>
      <div class="chips">
        {
          appEmbeds.map((app, i) => (
            <button
              class={`chip${i === 0 ? ' active' : ''}`}
              data-app={app.id}
              data-url={app.embedUrl}
              data-open={app.openUrl}
              data-strap={app.strap}
              data-title={app.title}
            >
              {app.title}
              <span class="chip-tag mono">{app.tag}</span>
            </button>
          ))
        }
      </div>
      <div class="app-frame">
        <div class="chrome">
          <span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span>
          <span class="mono url" id="app-url">{firstApp.embedUrl.replace('https://', '')}</span>
          <a class="open mono" id="app-open" href={firstApp.openUrl} target="_blank" rel="noopener">Open ↗</a>
        </div>
        <iframe
          id="app-iframe"
          src={firstApp.embedUrl}
          title={firstApp.title}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
        ></iframe>
      </div>
      <p class="app-strap" id="app-strap">{firstApp.strap}</p>
    </div>

    <!-- READ -->
    <div class="panel" id="panel-read" role="tabpanel" hidden>
      <div class="read-grid">
        {
          reads.map((outlet) => (
            <div class="read-col">
              <div class="mono read-kicker">{outlet.kicker}</div>
              <h4><a href={outlet.href} target="_blank" rel="noopener">{outlet.outlet} ↗</a></h4>
              <ul>
                {outlet.items.map((a) => (
                  <li>
                    <a href={a.href} target="_blank" rel="noopener">{a.title}</a>
                    {a.note && <span class="mono note">{a.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('#media [role=tab]');
  const panels: Record<string, HTMLElement | null> = {
    watch: document.getElementById('panel-watch'),
    run: document.getElementById('panel-run'),
    read: document.getElementById('panel-read'),
  };
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      for (const [key, panel] of Object.entries(panels)) {
        if (panel) panel.hidden = key !== tab.dataset.tab;
      }
    })
  );

  // Watch: click a title -> that video plays
  const player = document.getElementById('yt-player') as HTMLIFrameElement | null;
  document.querySelectorAll<HTMLButtonElement>('.vitem').forEach((item) =>
    item.addEventListener('click', () => {
      if (!player) return;
      player.src = `https://www.youtube-nocookie.com/embed/${item.dataset.video}?autoplay=1`;
      document.querySelectorAll('.vitem').forEach((v) => v.classList.remove('active'));
      item.classList.add('active');
    })
  );

  // Run: click a chip -> that app loads in the frame
  const appFrame = document.getElementById('app-iframe') as HTMLIFrameElement | null;
  const appUrl = document.getElementById('app-url');
  const appOpen = document.getElementById('app-open') as HTMLAnchorElement | null;
  const appStrap = document.getElementById('app-strap');
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) =>
    chip.addEventListener('click', () => {
      if (!appFrame || !chip.dataset.url) return;
      appFrame.src = chip.dataset.url;
      if (appUrl) appUrl.textContent = chip.dataset.url.replace('https://', '');
      if (appOpen && chip.dataset.open) appOpen.href = chip.dataset.open;
      if (appStrap && chip.dataset.strap) appStrap.textContent = chip.dataset.strap;
      document.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
    })
  );
</script>

<style>
  section {
    background:
      radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--color-accent-200) 55%, transparent), transparent 70%),
      radial-gradient(900px 420px at 0% 110%, color-mix(in srgb, var(--color-accent-2-200) 60%, transparent), transparent 70%),
      var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 42px);
    margin: 12px 0 0;
    max-width: 780px;
    letter-spacing: -0.015em;
  }
  .sub { font-size: 16.5px; color: var(--color-neutral-700); max-width: 640px; margin: 14px 0 0; }

  .tabs {
    display: inline-flex;
    gap: 4px;
    margin-top: 30px;
    padding: 5px;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    box-shadow: var(--shadow-sm);
  }
  .tabs button {
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-neutral-700);
  }
  .tabs button[aria-selected='true'] { background: var(--color-accent); color: #fff; }

  .panel { margin-top: 26px; }

  /* watch */
  .watch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 800px) { .watch-grid { grid-template-columns: 1fr; } }
  .player-shell {
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-lg);
  }
  .player-shell iframe { width: 100%; height: 100%; border: 0; display: block; }
  .vlist {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .vitem {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
    border: 1px solid var(--color-divider);
    background: var(--color-bg);
    border-radius: 14px;
    padding: 11px 14px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-text);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .vitem:hover { border-color: var(--color-accent-400); }
  .vitem.active { background: var(--color-accent-100); border-color: var(--color-accent-400); }
  .vplay { color: var(--color-accent-600); font-size: 10px; flex: none; }
  .vtitle { flex: 1; line-height: 1.35; }
  .vtag {
    font-size: 9.5px;
    font-weight: 700;
    color: var(--color-accent-2-700);
    background: var(--color-accent-2-100);
    padding: 3px 8px;
    border-radius: 999px;
    flex: none;
  }

  /* run */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-divider);
    background: var(--color-bg);
    border-radius: 999px;
    padding: 9px 16px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--color-text);
    cursor: pointer;
  }
  .chip:hover { border-color: var(--color-accent-400); }
  .chip.active { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .chip-tag { font-size: 9.5px; opacity: 0.75; }
  .app-frame {
    margin-top: 16px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--color-divider);
    background: var(--color-bg);
    box-shadow: var(--shadow-lg);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px;
    background: var(--color-neutral-200);
    border-bottom: 1px solid var(--color-divider);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .d1 { background: #c96442; }
  .d2 { background: #7a8a5e; }
  .d3 { background: #c0b6a5; }
  .url {
    margin-left: 6px;
    font-size: 11px;
    color: var(--color-neutral-700);
    background: var(--color-bg);
    padding: 3px 12px;
    border-radius: 999px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .open { margin-left: auto; font-size: 11.5px; font-weight: 700; }
  #app-iframe { width: 100%; height: min(72vh, 640px); border: 0; display: block; background: #fff; }
  .app-strap { margin-top: 12px; font-size: 14px; color: var(--color-neutral-700); }

  /* read */
  .read-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .read-col {
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: 20px;
    padding: 24px;
  }
  .read-kicker { font-size: 10.5px; font-weight: 700; color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.06em; }
  .read-col h4 { font-size: 19px; margin: 8px 0 6px; }
  .read-col h4 a { text-decoration: none; }
  .read-col ul { list-style: none; margin: 0; padding: 0; }
  .read-col li {
    padding: 9px 0;
    border-bottom: 1px solid var(--color-divider);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .read-col li:last-child { border-bottom: 0; }
  .read-col li a { font-weight: 600; text-decoration: none; }
  .read-col li a:hover { text-decoration: underline; }
  .note { display: block; font-size: 10px; color: var(--color-neutral-600); margin-top: 2px; }
</style>
