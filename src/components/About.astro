---
import { about } from '../data/pillars';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="about">
  <div class="wrap section-pad grid">
    <div>
      <div class="kicker">{about.kicker}</div>
      <h2>{about.heading}</h2>
      {about.paragraphs.map((p) => <p class="para">{p}</p>)}
      <div class="chips">
        {about.institutions.map((inst) => <span>{inst}</span>)}
      </div>
    </div>
    <div class="figure">
      <div class="frame">
        <div class="tilt"></div>
        <img src={`${base}/logo.jpg`} alt="TechNektar — Cross-Pollinating Innovation" />
      </div>
    </div>
  </div>
</section>

<style>
  section { border-bottom: 1px solid var(--color-divider); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 44px;
    align-items: center;
  }
  h2 {
    font-size: clamp(26px, 3vw, 36px);
    margin: 12px 0 0;
    letter-spacing: -0.015em;
  }
  .para {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-neutral-800);
    margin: 18px 0 0;
  }
  .para + .para { margin-top: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .chips span {
    font-size: 12px;
    font-weight: 700;
    padding: 6px 13px;
    border-radius: 999px;
    background: var(--color-neutral-200);
    color: var(--color-neutral-700);
  }
  .figure { display: flex; justify-content: center; }
  .frame { position: relative; width: min(340px, 80vw); }
  .tilt {
    position: absolute;
    inset: -14px;
    background: var(--color-accent-100);
    border-radius: 32px;
    transform: rotate(-3deg);
  }
  .frame img {
    position: relative;
    width: 100%;
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }
</style>
