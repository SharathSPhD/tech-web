---
import { stats } from '../data/media';
---

<div class="band">
  <div class="wrap row reveal-stagger">
    {
      stats.map((s) => (
        <div class="stat">
          <div class="mono value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .band {
    background: linear-gradient(100deg, #221a12, var(--term-bg) 55%, #1d2014);
    border-bottom: 1px solid var(--color-divider);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 44px;
    padding: 22px clamp(26px, 4vw, 52px);
    justify-content: space-between;
  }
  .stat { display: flex; align-items: baseline; gap: 10px; }
  .value {
    font-size: 26px;
    font-weight: 700;
    color: var(--term-orange);
    letter-spacing: -0.02em;
  }
  .stat:nth-child(even) .value { color: var(--term-green); }
  .label { font-size: 13px; font-weight: 600; color: var(--term-dim); }
</style>
